# ============================================================
# DATA — never commit raw, processed, or augmented data CSVs
# (too large; preprocess scripts regenerate everything)
# ============================================================
data/

# ============================================================
# TRAINED MODELS — keep plots and JSON results, exclude binaries
# ============================================================
trained_models/**/*.pt
trained_models/**/*.joblib
trained_models/**/*.pkl

# CEEMDAN IMF cache (auto-generated by train_model.py, can be large)
**/.ceemdan_cache/

# ============================================================
# OLD / SUPERSEDED SCRIPTS
# ============================================================
preprocess_data.py
download_water_quality.py
download_wq_final.py
find_wq_stations.py
find_wq_stations_v2.py
find_wq_stations_v3.py
tifverif.py
old-model/
docs/

# ============================================================
# LARGE GEOSPATIAL BINARY DATA
# ============================================================
tifs/
shapefile/
*.tif
*.geotiff
*.shp
*.shx
*.dbf
*.prj

# ============================================================
# PYTHON
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
*.so
*.pyd

